<?xml version="1.0" encoding="utf-8" ?>
<odoo>
    <template id="pager" inherit_id="portal.pager">
        <!-- Placed after the <ul> root so the selector stays visible even
             when there is a single page (the <ul> hides itself then). -->
        <xpath expr="//ul" position="after">
            <select
                t-if="portal_pager_size_options"
                class="o_portal_pager_size form-select form-select-sm w-auto"
                aria-label="Records per page"
                title="Records per page"
            >
                <option
                    t-foreach="portal_pager_size_options"
                    t-as="size_option"
                    t-att-value="size_option"
                    t-att-selected="'selected' if size_option == portal_pager_size else None"
                    t-out="size_option"
                />
            </select>
        </xpath>
    </template>
</odoo>
