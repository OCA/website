<odoo>
    <record id="res_config_settings_view_form_inherit_website_llms" model="ir.ui.view">
        <field name="model">res.config.settings</field>
        <field name="inherit_id" ref="website.res_config_settings_view_form" />
        <field name="arch" type="xml">
            <xpath expr="//setting[@id='website_cookies_bar_setting']" position="after">
                <setting id="website_llms_setting">
                    <div class="row mt16">
                        <label
                            class="col-lg-3"
                            string="llms.txt Content"
                            for="llms_txt_content"
                        />
                        <div class="col-lg-9">
                            <field
                                name="llms_txt_content"
                                widget="text"
                                placeholder="# Your Website — Information for LLMs&#10;&#10;## Company&#10;- About: https://yourdomain.com/aboutus&#10;- Contact: https://yourdomain.com/contactus&#10;&#10;## Content&#10;- Blog: https://yourdomain.com/blog"
                                invisible="not website_id"
                            />
                            <div class="text-muted mt-2">
                                Content to be served at <code
                            >/llms.txt</code>. This file provides
                                information for Large Language Models (LLMs) about your website.
                                Leave empty to use default content.
                            </div>
                        </div>
                    </div>
                </setting>
            </xpath>
        </field>
    </record>
</odoo>
