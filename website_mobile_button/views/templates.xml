<?xml version="1.0" encoding="utf-8" ?>
<odoo>
    <!-- ============================================================
         1. The bar (toggle per website + editable zone)
         Each button is a <div> (not a link). The link is an empty,
         invisible <a> stretched over the whole button, so the text
         is never "a link" in the editor and the whole button is
         clickable on the website.
         ============================================================ -->
    <template
        id="mobile_bottom_bar"
        inherit_id="website.layout"
        name="Mobile Bottom Bar"
        active="False"
        customize_show="True"
    >
        <xpath expr="//div[@id='wrapwrap']" position="inside">
            <div
                id="oe_structure_mobile_bottom_bar"
                class="o_mobile_bottom_bar oe_structure d-lg-none"
            >
                <div class="o_mobile_bar_row">
                    <div class="s_mobile_bar_item o_mobile_bottom_bar_item">
                        <i class="fa fa-home fa-lg" />
                        <span class="o_mobile_bar_label">Home</span>
                        <a
                            href="/"
                            class="o_mobile_bar_link stretched-link"
                            aria-label="Home"
                        />
                    </div>

                    <div class="s_mobile_bar_item o_mobile_bottom_bar_item">
                        <i class="fa fa-th-large fa-lg" />
                        <span class="o_mobile_bar_label">Shop</span>
                        <a
                            href="/shop"
                            class="o_mobile_bar_link stretched-link"
                            aria-label="Shop"
                        />
                    </div>

                    <div class="s_mobile_bar_item o_mobile_bottom_bar_item">
                        <i class="fa fa-shopping-cart fa-lg" />
                        <span class="o_mobile_bar_label">Cart</span>
                        <a
                            href="/shop/cart"
                            class="o_mobile_bar_link stretched-link"
                            aria-label="Cart"
                        />
                    </div>

                    <div class="s_mobile_bar_item o_mobile_bottom_bar_item">
                        <i class="fa fa-user fa-lg" />
                        <span class="o_mobile_bar_label">Account</span>
                        <a
                            href="/my"
                            class="o_mobile_bar_link stretched-link"
                            aria-label="Account"
                        />
                    </div>
                </div>
            </div>
        </xpath>
    </template>

    <!-- ============================================================
         2. Snippet: one button (what users drag into the bar)
         ============================================================ -->
    <template id="s_mobile_bar_item" name="Bottom Bar Button">
        <div class="s_mobile_bar_item o_mobile_bottom_bar_item">
            <i class="fa fa-star fa-lg" />
            <span class="o_mobile_bar_label">Label</span>
            <a href="#" class="o_mobile_bar_link stretched-link" aria-label="Button" />
        </div>
    </template>

    <!-- ============================================================
         3. Register the snippet in the editor panel
         ============================================================ -->
    <template
        id="snippets"
        inherit_id="website.snippets"
        name="Mobile Bottom Bar Snippets"
    >
        <xpath expr="//snippets[@id='snippet_content']" position="inside">
            <t
                t-snippet="website_mobile_button.s_mobile_bar_item"
                string="Bottom Bar Button"
            />
        </xpath>
    </template>

    <!-- ============================================================
         4. Options panels
         ============================================================ -->
    <template
        id="snippet_options"
        inherit_id="website.snippet_options"
        name="Mobile Bottom Bar Options"
    >
        <xpath expr="." position="inside">
            <!-- Options for each button (select the button's padding area) -->
            <div
                data-selector=".s_mobile_bar_item"
                data-drop-near=".s_mobile_bar_item"
                data-drop-in=".o_mobile_bar_row"
            >
                <we-input
                    string="Link (URL)"
                    data-select-attribute=""
                    data-attribute-name="href"
                    data-apply-to=".o_mobile_bar_link"
                    data-no-preview="true"
                    placeholder="/shop"
                />

                <we-checkbox
                    string="Open in new tab"
                    data-select-attribute="_blank"
                    data-attribute-name="target"
                    data-apply-to=".o_mobile_bar_link"
                />

                <we-colorpicker
                    string="Background"
                    data-select-style="true"
                    data-css-property="background-color"
                />

                <we-colorpicker
                    string="Text / icon color"
                    data-select-style="true"
                    data-css-property="color"
                />

                <we-button-group string="Label">
                    <we-button
                        data-select-class=""
                        data-apply-to=".o_mobile_bar_label"
                    >Show</we-button>
                    <we-button
                        data-select-class="d-none"
                        data-apply-to=".o_mobile_bar_label"
                    >Hide</we-button>
                </we-button-group>

                <we-select string="Icon size">
                    <we-button
                        data-select-class="fa-1x"
                        data-apply-to="i"
                    >Normal</we-button>
                    <we-button
                        data-select-class="fa-lg"
                        data-apply-to="i"
                    >Large</we-button>
                    <we-button
                        data-select-class="fa-2x"
                        data-apply-to="i"
                    >Extra large</we-button>
                </we-select>
            </div>

            <!-- Options for the whole bar -->
            <div data-selector=".o_mobile_bottom_bar" data-no-check="true">
                <we-colorpicker
                    string="Background"
                    data-select-style="true"
                    data-css-property="background-color"
                />

                <we-select string="Shadow">
                    <we-button data-select-class="">None</we-button>
                    <we-button data-select-class="shadow-sm">Small</we-button>
                    <we-button data-select-class="shadow">Medium</we-button>
                </we-select>

                <we-select string="Separators">
                    <we-button data-select-class="">Line</we-button>
                    <we-button
                        data-select-class="o_mobile_bar_sep_short"
                    >Short line</we-button>
                    <we-button
                        data-select-class="o_mobile_bar_sep_none"
                    >None</we-button>
                </we-select>
            </div>
        </xpath>
    </template>
</odoo>
