<odoo>
    <record
        id="res_config_settings_view_form_inherit_reseller_page_header"
        model="ir.ui.view"
    >
        <field
            name="name"
        >res.config.settings.view.form.inherit.reseller.page.header</field>
        <field name="model">res.config.settings</field>
        <field name="inherit_id" ref="website.res_config_settings_view_form" />
        <field name="arch" type="xml">
            <xpath
                expr="//app[@name='website']//block[@id='website_info_settings']"
                position="inside"
            >
                <setting
                    string="Reseller Page Header"
                    help="Heading displayed on the Find Resellers page."
                >
                    <field name="reseller_page_header" placeholder="Find a reseller" />
                </setting>
            </xpath>
        </field>
    </record>
</odoo>
