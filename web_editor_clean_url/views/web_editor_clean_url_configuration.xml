<data>
    <record id="view_web_editor_clean_url_configuration_form" model="ir.ui.view">
        <field name="model">web.editor.clean.url.configuration</field>
        <field name="arch" type="xml">
            <form>
                <group name="main">
                    <field name="hostname" />
                    <field name="remove_query_parameter" />
                    <field name="replace_regex" />
                    <field
                        name="replace_regex_sub"
                        attrs="{'invisible': [('replace_regex', '=', False)]}"
                    />
                </group>
                <group name="preview">
                    <field name="test_url" widget="url" />
                    <field name="preview_url" widget="url" />
                </group>
            </form>
        </field>
    </record>
    <record id="view_web_editor_clean_url_configuration_list" model="ir.ui.view">
        <field name="model">web.editor.clean.url.configuration</field>
        <field name="arch" type="xml">
            <tree>
                <field name="sequence" widget="handle" />
                <field name="hostname" />
                <field name="remove_query_parameter" />
                <field name="replace_regex" />
                <field name="replace_regex_sub" />
            </tree>
        </field>
    </record>
    <record
        id="action_web_editor_clean_url_configuration"
        model="ir.actions.act_window"
    >
        <field name="name">Clean URLs</field>
        <field name="res_model">web.editor.clean.url.configuration</field>
        <field name="view_mode">tree,form</field>
    </record>
</data>
