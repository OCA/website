#. module: website_crm_quick_answer
#: model:mail.template,body_html:website_crm_quick_answer.email_template
msgid ""
"<div>Dear <t t-out=\"object.partner_id.name or object.contact_name or ''\"/>\n"
"                    <br/>\n"
"                    <br/>\n"
"                    <h3>Thanks for contacting us!</h3>\n"
"                    <p>\n"
"                        We have received your request and will answer you as soon as\n"
"                        possible.\n"
"                    </p>\n"
"                    <p>Please, be patient. Best regards.</p>\n"
"                    <p>Thanks,</p>\n"
"                </div>\n"
"        "
msgstr ""
"<div>Spoštovani <t t-out=\"object.partner_id.name or object.contact_name or "
"''\"/>\n"
"                    <br/>\n"
"                    <br/>\n"
"                    <h3>Hvala, da ste nas kontaktirali!</h3>\n"
"                    <p>\n"
"                        Prejeli smo vaše vprašanje in vam bomo odgovorili "
"takoj, ko\n"
"                        bo mogoče.\n"
"                    </p>\n"
"                    <p>Prosimo, bodite potrpežljivi. Lep pozdrav.</p>\n"
"                    <p>Hvala,</p>\n"
"                </div>\n"
"        "

#. module: website_crm_quick_answer
