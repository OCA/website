<?xml version="1.0" encoding="utf-8" ?>
<odoo>
    <record id="res_config_settings_view_form" model="ir.ui.view">
        <field name="name">
           res.config.settings.view.form.inherit.cookiefirst
       </field>
        <field name="model">res.config.settings</field>
        <field name="inherit_id" ref="website.res_config_settings_view_form" />
        <field name="arch" type="xml">
            <xpath expr="//setting[@id='website_cookies_bar_setting']" position="after">
                <setting id="altcha" help="Add Altcha functionality">
                    <field name="altcha_enabled" />
                    <div class="mt16" invisible="not altcha_enabled">
                        <label
                            class="col-md-3 o_light_label"
                            string="HMAC secret"
                            for="altcha_key"
                        />
                        <field
                            name="altcha_key"
                            required="altcha_enabled"
                            placeholder="00000000-0000-0000-0000-000000000000"
                        />
                    </div>
                    <div class="mt16" invisible="not altcha_enabled">
                        <label
                            class="col-md-3 o_light_label"
                            string="HMAC key secret"
                            for="altcha_private_key"
                        />
                        <field
                            name="altcha_private_key"
                            required="altcha_enabled"
                            placeholder="00000000-0000-0000-0000-000000000000"
                        />
                    </div>
                    <div class="mt16" invisible="not altcha_enabled">
                        <label
                            class="col-md-3 o_light_label"
                            string="Algorithm"
                            for="altcha_algorithm"
                        />
                        <field name="altcha_algorithm" required="altcha_enabled" />
                    </div>
                    <div class="mt16" invisible="not altcha_enabled">
                        <label
                            class="col-md-3 o_light_label"
                            string="Timeout"
                            for="altcha_timeout"
                        />
                        <field name="altcha_timeout" required="altcha_enabled" />
                    </div>
                    <div class="mt16" invisible="not altcha_enabled">
                        <label
                            class="col-md-3 o_light_label"
                            string="Cost"
                            for="altcha_cost"
                        />
                        <field name="altcha_cost" required="altcha_enabled" />
                    </div>
                </setting>
            </xpath>
        </field>
    </record>
</odoo>
