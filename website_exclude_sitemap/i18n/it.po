#. module: website_exclude_sitemap
#: model:ir.model,name:website_exclude_sitemap.model_res_config_settings
msgid "Config Settings"
msgstr "Impostazioni configurazione"

#. module: website_exclude_sitemap
#: model_terms:ir.ui.view,arch_db:website_exclude_sitemap.res_config_settings_view_form
msgid "Exclude specific URLs or wildcard patterns from sitemap.xml."
msgstr "Escludere URL specifici o pattern con caratteri jolly da sitemap.xml."

#. module: website_exclude_sitemap
#: model:ir.model.fields,help:website_exclude_sitemap.field_res_config_settings__sitemap_excluded_paths
#: model:ir.model.fields,help:website_exclude_sitemap.field_website__sitemap_excluded_paths
msgid ""
"One path or pattern per line, comma, or semicolon. * matches inside one path"
" segment, ** across segments, and a trailing / excludes a path and "
"everything below it. Examples: /contactus, /solutions*, /blog/*/feed, "
"/customers/, /jobs/**"
msgstr ""
"Un percorso o pattern per riga, separati da virgola o punto e virgola. * "
"corrisponde all'interno di un singolo segmento del percorso, ** attraverso "
"più segmenti e una / finale esclude il percorso e tutto ciò che vi è "
"contenuto. Esempi: /contactus, /solutions*, /blog/*/feed, /customers/, /jobs/"
"**"

#. module: website_exclude_sitemap
#: model:ir.model,name:website_exclude_sitemap.model_website_page
msgid "Page"
msgstr "Pagina"

#. module: website_exclude_sitemap
#: model_terms:ir.ui.view,arch_db:website_exclude_sitemap.res_config_settings_view_form
msgid "Reload Sitemap"
msgstr "Ricarica mappa sito"

#. module: website_exclude_sitemap
#: model_terms:ir.ui.view,arch_db:website_exclude_sitemap.res_config_settings_view_form
msgid ""
"Separate paths with line breaks, commas, or semicolons.\n"
"                        Use * inside a segment, ** across segments, and a\n"
"                        trailing / to exclude a path and everything below it."
msgstr ""
"Separare i percorsi con interruzioni di riga, virgole o punti e virgola. \n"
"                        Usare * all'interno di un segmento, ** tra i "
"segmenti e una\n"
"                        / finale per escludere un percorso e tutto ciò che "
"contiene."

#. module: website_exclude_sitemap
#: model:ir.model.fields,field_description:website_exclude_sitemap.field_res_config_settings__sitemap_excluded_paths
#: model:ir.model.fields,field_description:website_exclude_sitemap.field_website__sitemap_excluded_paths
#: model_terms:ir.ui.view,arch_db:website_exclude_sitemap.res_config_settings_view_form
msgid "Sitemap Exclusions"
msgstr "Esclusioni mappa sito"

