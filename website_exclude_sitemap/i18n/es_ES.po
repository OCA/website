#. module: website_exclude_sitemap
#: model_terms:ir.ui.view,arch_db:website_exclude_sitemap.res_config_settings_view_form
msgid ""
"Separate paths with line breaks, commas, or semicolons.\n"
"                            Use * for wildcard matches."
msgstr ""
"Separar rutas con saltos de línea, comas o punto y coma.\n"
"                            Usar * para coincidencias con comodín."

